# LinkedIn SDR Environment Configuration
# Copy this file to .env and fill in your actual values

# Application Mode
# Use "server" for FastAPI server, "consumer" for Kafka consumer
MODE=
PORT=

# Database Configuration
MONGO_URI=

# Chronos Service Configuration (Remote)
CHRONOS_INTRNL_SVC=

# Kafka Configuration
KAFKA_BROKER_LIST=
CONSUMER_TYPE=

# Unipile API Configuration
# Get these from your Unipile dashboard
UNIPILE_API_TOKEN=
UNIPILE_API_URL=

# Optional: Logging and Monitoring
LOG_LEVEL=
DEBUG=