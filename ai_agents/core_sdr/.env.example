# Required API keys
CORESIGNAL_API_KEY=your_coresignal_api_key_here
OPENAI_API_KEY=your_openai_api_key_here

# Optional configuration
CORESIGNAL_BASE_URL=https://api.coresignal.com
MONGODB_URI=mongodb://localhost:27017/leadgen
LOG_LEVEL=INFO
CACHE_TTL_HOURS=24
LLM_MODEL=gpt-4o

# Feature flags (all disabled by default)
SCHEMA_AUTO_UPDATE=false
SCHEMA_API_DRIVEN_UPDATES=false
SCHEMA_SCHEDULED_UPDATES=false